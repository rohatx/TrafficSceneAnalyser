<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".analysisInfoPage">

    <!-- DESIGNS -->

    <ImageView
        android:id="@+id/backg"
        android:layout_width="904dp"
        android:layout_height="897dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.12"
        app:srcCompat="@drawable/background" />

    <!-- MODEL INFO TEXT -->

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="484dp"
        android:layout_height="773dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.505"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/perfectlayout2" />

    <TextView
        android:id="@+id/modelInfoDescTextView"
        android:layout_width="333dp"
        android:layout_height="116dp"
        android:layout_marginTop="556dp"
        android:text="Description"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/modelInfoHeadlineTextview"
        android:layout_width="230dp"
        android:layout_height="70dp"
        android:text="SelectedModel"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/modelInfoDescTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.207" />

    <TextView
        android:id="@+id/modelInfoDevsTextView"
        android:layout_width="250dp"
        android:layout_height="53dp"
        android:layout_marginBottom="16dp"
        android:autoLink="web"
        android:text="@string/modelInfoDevs"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.531"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/modelInfoCostsTextView"
        android:layout_width="233dp"
        android:layout_height="42dp"
        android:layout_marginBottom="16dp"
        android:text="@string/modelInfoCosts"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/modelInfoDevsTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- LOGO -->

    <ImageView
        android:id="@+id/modelInfoLogoImageView"
        android:layout_width="271dp"
        android:layout_height="136dp"
        android:layout_marginTop="56dp"
        app:layout_constraintBottom_toTopOf="@+id/modelInfoDescTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/modelInfoHeadlineTextview"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/image_not_found" />

    <ImageView
        android:id="@+id/modelInfoBenchmarkImageView"
        android:layout_width="355dp"
        android:layout_height="772dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.421"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/modelInfoLogoImageView"
        app:layout_constraintVertical_bias="0.536"
        app:srcCompat="@drawable/tabelle" />

    <!-- BENCHMARK TABLE -->


</androidx.constraintlayout.widget.ConstraintLayout>