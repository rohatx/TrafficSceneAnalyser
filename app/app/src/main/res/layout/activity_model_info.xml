<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".analysisInfoPage">

    <ImageView
        android:id="@+id/backg"
        android:layout_width="904dp"
        android:layout_height="897dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.12"
        app:srcCompat="@drawable/background" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="250dp"
        android:layout_height="400dp"
        android:layout_marginTop="150dp"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </androidx.viewpager2.widget.ViewPager2>

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="484dp"
        android:layout_height="773dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.643"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/perfectlayout2" />

    <TextView
        android:id="@+id/modelInfoDescTextView"
        android:layout_width="323dp"
        android:layout_height="74dp"
        android:layout_marginTop="100dp"
        android:text="Description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/modelInfoHeadlineTextview"
        android:layout_width="165dp"
        android:layout_height="45dp"
        android:text="SelectedModel"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/modelInfoDescTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/modelInfoLinksTextView"
        android:layout_width="317dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:text="Links"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.531"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/modelInfoCostsTextView"
        android:layout_width="311dp"
        android:layout_height="46dp"
        android:layout_marginBottom="16dp"
        android:text="Costs per request"
        app:layout_constraintBottom_toTopOf="@+id/modelInfoLinksTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/modelInfoParameterTextView"
        android:layout_width="315dp"
        android:layout_height="50dp"
        android:text="No of Parameters"
        app:layout_constraintBottom_toTopOf="@+id/modelInfoCostsTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/modelInfoSuccessRateTextView"
        android:layout_width="329dp"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:text="Success Rate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/modelInfoDescTextView" />

    <TextView
        android:id="@+id/modelInfoBenchmarksTextView"
        android:layout_width="328dp"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="Benchmarks"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/modelInfoSuccessRateTextView" />

    <TextView
        android:id="@+id/modelInfoSpeedTextView"
        android:layout_width="323dp"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:text="Speed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/modelInfoBenchmarksTextView" />

</androidx.constraintlayout.widget.ConstraintLayout>