<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:clipChildren="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageViewPopup"
            android:layout_width="match_parent"
            android:layout_height="200dp" />

        <TextView
            android:id="@+id/textViewPopUp"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_margin="8dp"
            android:text="Das Objekt ist mit x% unterfahrbar. Somit kann es (nicht) unterfahren werden."
            android:textAlignment="center"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/textViewInfoPopUp"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_margin="8dp"
            android:text="Das Objekt ist mit x% unterfahrbar. Somit kann es (nicht) unterfahren werden."
            android:textAlignment="center"
            android:visibility="gone"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/textViewReasoningPopUp"
            android:layout_width="match_parent"
            android:layout_height="79dp"
            android:layout_margin="8dp"
            android:text="Die Begruendung dafuer lautet: Reasoning"
            android:textAlignment="center"
            android:visibility="gone"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/textViewSanityCheckPopUp"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_margin="8dp"
            android:text="Auch der Sanity Check blabla"
            android:textAlignment="center"
            android:visibility="gone"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/textViewImageQualityPopUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:textColor="@drawable/clickable_text_view_selector"
            android:text="@string/test"
            android:textAlignment="center"
            android:visibility="gone"
            android:textIsSelectable="true" />

    </LinearLayout>
</LinearLayout>
