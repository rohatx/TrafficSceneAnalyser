    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <ImageView
            android:id="@+id/imageViewOutputIcon"
            android:layout_width="0dp"
            android:layout_height="67dp"
            android:layout_weight="1"
            android:tooltipText="@string/imageOutputIcon"
            android:src="@drawable/tunnel_freepik" />
        <!--
        <TextView
            android:id="@+id/textViewOutput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="8dp"
            android:text="@string/boilerplate_text"
            android:textSize="16sp" />
        -->
        <ImageView
            android:id="@+id/imageViewOutput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/icons8_questionmark" />

        <ImageView
            android:id="@+id/imageViewAccuracy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tooltipText="@string/imageAccuracyIcon"
            android:src="@drawable/accuracy_freepik" />

        <TextView
            android:id="@+id/textViewAccuracy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="0.5"
            android:textAlignment="center"
            android:textSize="48sp" />

    </LinearLayout>



</LinearLayout>
