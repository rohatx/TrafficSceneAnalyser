<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Internet-Berechtigung hinzufügen -->
    <uses-permission android:name="android.permission.INTERNET" /> <!-- Speicher- Berechtigung hinzufügen -->
    <!-- Berechtigung für benachrichtigungen -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:ignore="SelectedPhotoAccess" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrafficSceneAnalyser"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:name=".activities.tutorials.QualityTutActivity"
            android:exported="false" />
        <activity
            android:name=".activities.tutorials.UrlTutActivity"
            android:exported="false" />
        <activity
            android:name=".activities.tutorials.BilderTutActivity"
            android:exported="false" />
        <activity
            android:name=".activities.tutorials.AccountTutActivity"
            android:exported="false" />
        <activity
            android:name=".activities.tutorials.TutorialActivity"
            android:exported="false" />
        <activity
            android:name=".activities.analysis.getUrlActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.analysis.analysisInfoPage"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.models.ModelListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.analysis.HistoryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.auth.RegisterActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.auth.SignInActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.profile.ProfileLoggedInActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.analysis.AnalysisInfoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.analysis.CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.analysis.UploadConfigActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.profile.ProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.settings.SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:parentActivityName=".activities.home.MainActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activities.home.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>